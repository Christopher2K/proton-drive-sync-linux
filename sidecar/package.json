{
  "name": "proton-drive-sync-sidecar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Node.js sidecar wrapping the official Proton Drive SDK for the proton-drive-sync host app",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "spike": "tsx src/spike.ts",
    "start": "tsx src/index.ts",
    "smoke": "tsx src/smoke.ts",
    "test": "tsx src/eventLoop.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@protontech/crypto": "^2.2.0",
    "@protontech/drive-sdk": "^0.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
